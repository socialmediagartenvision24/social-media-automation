# ============================================================================
# SOCIAL MEDIA AUTOMATION API
# Environment Configuration Example
# ============================================================================
#
# COPY THIS FILE TO:
#
#   backend/.env
#
# Then replace all placeholder values with your real credentials.
#
# NEVER commit backend/.env to GitHub.
# ============================================================================


# ============================================================================
# APPLICATION
# ============================================================================

APP_NAME=Social Media Automation API
APP_VERSION=1.0.0

ENVIRONMENT=development


# ============================================================================
# SERVER
# ============================================================================

API_HOST=0.0.0.0
API_PORT=8000


# ============================================================================
# FRONTEND
# ============================================================================

FRONTEND_URL=http://localhost:3000


# ============================================================================
# SUPABASE
# ============================================================================
#
# The SERVICE_ROLE_KEY is backend-only.
#
# NEVER:
#   - put it into the frontend
#   - use NEXT_PUBLIC_*
#   - expose it through an API response
#   - commit it to GitHub
#
# ============================================================================

SUPABASE_URL=https://edosrqljlnrbppmvvzqi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVkb3NycWxqbG5yYnBwbXZ2enFpIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NjYyMjgwNiwiZXhwIjoyMTAyMTk4ODA2fQ.yxAYIwlcUqQs_DoOW5euomE0-Or-P20IIbUEvoCqSnw


# ============================================================================
# JWT / AUTHENTICATION
# ============================================================================
#
# Use a long random secret in backend/.env.
#
# Example generation:
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# ============================================================================

JWT_SECRET=DEIN_LANGER_ZUFALLSSECRET


# ============================================================================
# SCHEDULER
# ============================================================================
#
# Enables the background scheduler responsible for processing
# scheduled publishing jobs.
#
# ============================================================================

SCHEDULER_ENABLED=true


# ============================================================================
# META / FACEBOOK / INSTAGRAM OAUTH
# ============================================================================
#
# Meta OAuth is used for Facebook and Instagram integrations.
#
# The exact permissions/scopes must match the capabilities approved
# for your Meta application.
#
# ============================================================================

META_APP_ID=
META_APP_SECRET=

META_REDIRECT_URI=http://localhost:8000/api/oauth/facebook/callback

META_SCOPES=


# ============================================================================
# TIKTOK OAUTH
# ============================================================================
#
# TikTok Login Kit / Content Posting API credentials.
#
# The exact scopes depend on the products/capabilities enabled
# for your TikTok developer application.
#
# ============================================================================

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

TIKTOK_REDIRECT_URI=http://localhost:8000/api/oauth/tiktok/callback

TIKTOK_SCOPES=user.info.basic,video.publish


# ============================================================================
# OPTIONAL APPLICATION SETTINGS
# ============================================================================

# Maximum number of publishing jobs processed per scheduler cycle.
# PUBLISHING_BATCH_SIZE=10

# Scheduler interval in seconds.
# SCHEDULER_INTERVAL_SECONDS=30

# HTTP request timeout for external platform APIs.
# PLATFORM_HTTP_TIMEOUT=30


# ============================================================================
# PRODUCTION NOTES
# ============================================================================
#
# For production replace:
#
# FRONTEND_URL=http://localhost:3000
#
# with your real HTTPS frontend URL.
#
# Also replace OAuth redirect URIs with your production HTTPS endpoints.
#
# Example:
#
# FRONTEND_URL=https://app.example.com
#
# META_REDIRECT_URI=https://api.example.com/api/oauth/facebook/callback
#
# TIKTOK_REDIRECT_URI=https://api.example.com/api/oauth/tiktok/callback
#
# ============================================================================
